{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MuseLink",
  "mainBinaryName": "muse-connector",
  "version": "0.2.2",
  "identifier": "io.github.aenvo.muselink",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Muse连接器",
        "width": 720,
        "height": 680,
        "resizable": true,
        "minWidth": 480,
        "minHeight": 400,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": false,
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/installer-hooks.nsh",
        "languages": [
          "SimpChinese",
          "English",
          "Japanese"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ4QTU1NTI1QUFGOUFENzUKUldSMXJmbXFKVldsU0xpaW9OakRwVm1GZzZ5Y0p4alVBZ3A0VnFWblBHWkJDMFArdnJhMmV3VS8K",
      "endpoints": [
        "https://github.com/Aenvo/MuseLink/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

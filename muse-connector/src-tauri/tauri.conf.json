{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MuseLink",
  "mainBinaryName": "muse-connector",
  "version": "0.1.0",
  "identifier": "io.github.aenvo.muselink",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Muse连接器",
        "width": 720,
        "height": 680,
        "resizable": true,
        "minWidth": 480,
        "minHeight": 400,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "",
      "endpoints": []
    }
  }
}
